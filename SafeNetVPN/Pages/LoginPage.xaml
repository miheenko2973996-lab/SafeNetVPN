<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SafeNetVPN.Pages.LoginPage"
             BackgroundColor="#FFD6DF">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Kopfbereich -->
        <VerticalStackLayout Grid.Row="0"
                             BackgroundColor="#FFD6DF"
                             Padding="15"
                             Spacing="11">

            <Label Text="SafeNetVPN"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Black" />

            <Label Text="Sicher. Einfach. Schnell"
                   FontSize="18"
                   HorizontalOptions="Center"
                   TextColor="Black" />

        </VerticalStackLayout>

        <!-- Inhalt -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20"
                             Spacing="45"
                             VerticalOptions="Center">

            <!-- Linie oben -->
            <BoxView HeightRequest="1"
                     BackgroundColor="Black"
                     Margin="0,0,0,55" />

            <!-- Benutzername -->
            <Grid ColumnDefinitions="100,*"
                  ColumnSpacing="10">

                <Label Grid.Column="0"
                       Text="Benutzname:"
                       FontSize="16"
                       TextColor="#B0005A"
                       VerticalOptions="Center" />

                <Entry x:Name="UsernameEntry"
                       Grid.Column="1"
                       Text="johnny"
                       HeightRequest="35"
                       FontSize="15"
                       BackgroundColor="White"
                       TextColor="Black" />

            </Grid>

            <!-- Passwort -->
            <Grid ColumnDefinitions="100,*"
                  ColumnSpacing="10">

                <Label Grid.Column="0"
                       Text="Passwort:"
                       FontSize="16"
                       TextColor="#B0005A"
                       VerticalOptions="Center" />

                <Entry x:Name="PasswordEntry" 
                       Grid.Column="1"
                       Placeholder="Passwort"
                       IsPassword="True"
                       HeightRequest="35"
                       FontSize="15"
                       BackgroundColor="White"
                       TextColor="Black" />

            </Grid>

            <!-- Anmelden Button -->
            <Button Text="Anmelden"
                    BackgroundColor="#D0006F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    WidthRequest="120"
                    HeightRequest="45"
                    HorizontalOptions="Center"
                    Margin="0,30,0,0"
                    Clicked="LoginButton_Clicked"/>

            <!-- Passwort vergessen -->
            <Label Text="Passwort vergessen?"
                   FontSize="15"
                   TextColor="#B0005A"
                   TextDecorations="Underline"
                   HorizontalOptions="Center" />

            <!-- Linie unten -->
            <BoxView HeightRequest="1"
                     BackgroundColor="Black"
                     Margin="0,15,0,15" />

            <Label Text="Noch kein Konto?"
                   FontSize="15"
                   TextColor="#B0005A"
                   HorizontalOptions="Center" 
                   Margin="0,-15,0,10"/>

            <Button Text="Registrieren"
                    BackgroundColor="#D0006F"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    WidthRequest="145"
                    HeightRequest="45"
                    HorizontalOptions="Center" 
                    Margin="0,-30,0,0"/>

        </VerticalStackLayout>

    </Grid>

</ContentPage>